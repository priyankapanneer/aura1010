# ==========================================
# AURA Application Environment Configuration
# ==========================================

# Application Settings
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration
# Primary: PostgreSQL (production / docker)
# Fallback: SQLite (development / standalone local)
DATABASE_URL=sqlite+aiosqlite:///./aura.db
SYNC_DATABASE_URL=sqlite:///./aura.db
# PostgreSQL Example:
# DATABASE_URL=postgresql+asyncpg://aura_user:aura_secret@localhost:5432/aura_db
# SYNC_DATABASE_URL=postgresql://aura_user:aura_secret@localhost:5432/aura_db

# LLM Provider Configuration
# Supported providers: "mock", "gemini", "openai", "anthropic"
LLM_PROVIDER=mock
LLM_MODEL=gemini-2.5-flash
# Set your API key if using real models (e.g. GEMINI_API_KEY, OPENAI_API_KEY, ANTHROPIC_API_KEY)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Calendar Integration Provider
# Options: "simulated", "google"
CALENDAR_PROVIDER=simulated

# Demo Mode & Seeding
DEMO_MODE=true
AUTO_SEED=true

# Security
SECRET_KEY=aura-development-secret-key-32-bytes-minimum!
DEFAULT_USER_EMAIL=aura_user@example.com
